# dependencies
node_modules/

# build output
out/
dist/

# generated by tsc --noEmit with incremental/composite projects
*.tsbuildinfo

# local env / logs
.env
.env.*
*.log
npm-debug.log*

# editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# NOTE: build/icon.ico and build/icon.png are intentionally NOT ignored.
